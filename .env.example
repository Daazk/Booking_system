POSTGRES_DB=booking_db
POSTGRES_USER=booking_user
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Used for local run without Docker (alembic / uvicorn on the host).
# In Docker Compose this value is overridden with host "db".
DATABASE_URL=postgresql+psycopg://booking_user:change_me@localhost:5432/booking_db
